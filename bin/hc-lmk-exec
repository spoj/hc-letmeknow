#!/bin/sh
set -eu

if [ "$#" -lt 3 ]; then
  echo "hc-lmk-exec: usage: hc-lmk-exec <encoded-opts> -- <command> [args...]" >&2
  exit 2
fi

ENCODED_OPTS=$1
shift
if [ "$1" != "--" ]; then
  echo "hc-lmk-exec: expected -- before command" >&2
  exit 2
fi
shift

SELF=$0
if [ -L "$SELF" ]; then
  SELF=$(node -e 'process.stdout.write(require("node:fs").realpathSync(process.argv[1]))' "$SELF")
fi
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
PREPARE="$SCRIPT_DIR/../src/prepare.mjs"

ENV_FILE=$(node "$PREPARE" "$ENCODED_OPTS" "$$")
cleanup() {
  if [ -n "${ENV_FILE:-}" ] && [ -f "$ENV_FILE" ]; then
    rm -f -- "$ENV_FILE"
  fi
}
trap cleanup EXIT HUP INT TERM

# shellcheck disable=SC1090
. "$ENV_FILE"
rm -f -- "$ENV_FILE"
ENV_FILE=
trap - EXIT HUP INT TERM

exec "$@"
