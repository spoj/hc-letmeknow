#!/usr/bin/env node
import { existsSync, readFileSync } from "node:fs";
import { isAlive, isMainModule, spawnCommand, stripEnvVar, termStatePath } from "../src/core.mjs";

export function resolveSessionTarget(env = process.env) {
  let bin = env.LETMEKNOW_BIN || "";
  let fp = env.LETMEKNOW_SESSION || "";
  if (bin && fp) {
    return { bin, fp, source: "env" };
  }

  const terminalId = env.HC_TERMINAL_ID;
  if (terminalId) {
    const file = termStatePath(terminalId);
    if (existsSync(file)) {
      let state;
      try {
        state = JSON.parse(readFileSync(file, "utf8"));
      } catch {
        state = null;
      }
      if (state && (state.sidecarPid === undefined || isAlive(state.sidecarPid))) {
        bin = bin || state.bin || "";
        fp = fp || state.fp || "";
        if (bin && fp) {
          return { bin, fp, source: "state" };
        }
      }
    }
  }
  return null;
}

async function main() {
  const args = process.argv.slice(2);
  const target = resolveSessionTarget(process.env);
  if (!target) {
    const tid = process.env.HC_TERMINAL_ID;
    console.error(
      `lmk: no active hc-letmeknow session (LETMEKNOW_SESSION/LETMEKNOW_BIN not set${tid ? ` and no active sidecar state for terminal ${tid}` : ""})`
    );
    process.exit(1);
  }

  const childEnv = stripEnvVar(process.env, "LETMEKNOW_SESSION");
  const onSigint = () => {};
  process.on("SIGINT", onSigint);
  const child = spawnCommand(target.bin, ["--session", target.fp, ...args], {
    stdio: "inherit",
    env: childEnv,
    windowsHide: false,
  });

  child.on("error", err => {
    process.off("SIGINT", onSigint);
    console.error(`lmk: failed to run ${target.bin}: ${err.message}`);
    process.exit(1);
  });
  child.on("exit", (code, signal) => {
    process.off("SIGINT", onSigint);
    if (signal && process.platform !== "win32") {
      process.kill(process.pid, signal);
      return;
    }
    process.exit(code ?? 1);
  });
}

if (isMainModule(import.meta.url, process.argv[1])) {
  await main();
}
